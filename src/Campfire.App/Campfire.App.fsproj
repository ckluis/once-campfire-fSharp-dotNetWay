  <ItemGroup>
    <ProjectReference Include="../Campfire.RailsCompat/Campfire.RailsCompat.fsproj" />
    <ProjectReference Include="../Campfire.Ruby/Campfire.Ruby.fsproj" />
    <ProjectReference Include="../Campfire.Routes/Campfire.Routes.fsproj" />
    <ProjectReference Include="../Campfire.Db/Campfire.Db.fsproj" />
    <ProjectReference Include="../Campfire.RichText/Campfire.RichText.fsproj" />
    <ProjectReference Include="../Campfire.Storage/Campfire.Storage.fsproj" />
    <ProjectReference Include="../Campfire.Cable/Campfire.Cable.fsproj" />
    <ProjectReference Include="../Campfire.Views/Campfire.Views.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- K2: the one registered scheme must not become the default (Web/Services.fs sets the same switch for hosts that are not this executable). -->
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.Authentication.SuppressAutoDefaultScheme" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Certes" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Falco" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Campfire.App.Tests" />
  </ItemGroup>
<PropertyGroup>
  <CampfireAssetsDir>$(MSBuildProjectDirectory)/Assets/</CampfireAssetsDir>
  <CampfireReferenceRoot>$(MSBuildProjectDirectory)/../../reference/</CampfireReferenceRoot>
</PropertyGroup>
<ItemGroup>
  <EmbeddedResource Include="$(CampfireReferenceRoot)config/importmap.rb" LogicalName="importmap.rb" />
</ItemGroup>
<!-- Propshaft's load path (Assets/overrides first, then Assets/vendor/LOAD_PATH; an override shadows the file of its logical
     path) and reference/public, copied into wwwroot/ (gitignored) before static web assets discovery. -->
<Target Name="CampfireStageWebRoot" BeforeTargets="ResolveProjectStaticWebAssets">
  <Error Condition="!Exists('$(CampfireReferenceRoot)config/importmap.rb')" Text="reference/ submodule is missing (git submodule update --init reference)" />
  <ReadLinesFromFile File="$(CampfireAssetsDir)vendor/LOAD_PATH">
    <Output TaskParameter="Lines" ItemName="_CampfireLoadPathLine" />
  </ReadLinesFromFile>
  <ItemGroup>
    <_CampfireLoadPathGlob Include="$([System.String]::Copy('%(_CampfireLoadPathLine.Identity)').Replace('reference:', '$(CampfireReferenceRoot)').Replace('vendor:', '$(CampfireAssetsDir)vendor/'))/**" />
    <!-- Nothing hidden is served: a dotfile or a file under a dot-directory (.keep, .DS_Store, .git/) is never staged. -->
    <_CampfireOverride Include="$(CampfireAssetsDir)overrides/**" />
    <_CampfireOverride Remove="@(_CampfireOverride)" Condition="$([System.String]::Copy('/%(_CampfireOverride.RecursiveDir)%(_CampfireOverride.Filename)%(_CampfireOverride.Extension)').Replace('\','/').Contains('/.'))" />
    <_CampfireOverride Link="wwwroot/assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <_CampfireAsset Include="@(_CampfireLoadPathGlob)" />
    <_CampfireAsset Remove="@(_CampfireAsset)" Condition="$([System.String]::Copy('/%(_CampfireAsset.RecursiveDir)%(_CampfireAsset.Filename)%(_CampfireAsset.Extension)').Replace('\','/').Contains('/.')) Or '%(_CampfireAsset.Extension)' == '.gz' Or '%(_CampfireAsset.Extension)' == '.br'" />
    <_CampfireAsset Link="wwwroot/assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <_CampfireAsset Remove="@(_CampfireOverride)" MatchOnMetadata="Link" />
    <_CampfirePublic Include="$(CampfireReferenceRoot)public/**" />
    <_CampfirePublic Remove="@(_CampfirePublic)" Condition="$([System.String]::Copy('/%(_CampfirePublic.RecursiveDir)%(_CampfirePublic.Filename)%(_CampfirePublic.Extension)').Replace('\','/').Contains('/.'))" />
    <_CampfirePublic Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <_CampfireStage Include="@(_CampfireOverride);@(_CampfireAsset);@(_CampfirePublic)" />
    <_CampfireRoot Include="$(CampfireAssetsDir)overrides;$(CampfireReferenceRoot)public" />
    <_CampfireRoot Include="$([System.String]::Copy('%(_CampfireLoadPathLine.Identity)').Replace('reference:', '$(CampfireReferenceRoot)').Replace('vendor:', '$(CampfireAssetsDir)vendor/'))" />
    <_CampfireRoot Remove="@(_CampfireRoot)" Condition="!Exists('%(_CampfireRoot.Identity)')" />
  </ItemGroup>
  <!-- No symbolic links: Copy follows them, so a link (to a file, or a directory the glob walks into) would stage whatever
       file of the build host it names into the web root, and the image would serve it (design-assets.md, Security review, F1). -->
  <Exec Condition="'$(OS)' != 'Windows_NT'" Command="find @(_CampfireRoot->'&quot;%(Identity)&quot;', ' ') -name '.*' -prune -o -type l -print" ConsoleToMSBuild="true" StandardOutputImportance="low" EchoOff="true">
    <Output TaskParameter="ConsoleOutput" ItemName="_CampfireSymlink" />
  </Exec>
  <Error Condition="'@(_CampfireSymlink)' != ''" Text="the web root's inputs hold a symbolic link, which would stage the file it names into the web root (replace it with the file itself): @(_CampfireSymlink, '; ')" />
  <Copy SourceFiles="@(_CampfireStage)" DestinationFiles="@(_CampfireStage->'%(Link)')" SkipUnchangedFiles="true">
    <Output TaskParameter="DestinationFiles" ItemName="_CampfireStaged" />
  </Copy>
  <ItemGroup>
    <_CampfireStale Include="wwwroot/**" Exclude="@(_CampfireStaged)" />
  </ItemGroup>
  <Delete Files="@(_CampfireStale)" />
  <ItemGroup>
    <Content Remove="@(_CampfireStaged);@(_CampfireStale)" />
    <Content Include="@(_CampfireStaged)" />
  </ItemGroup>
</Target>
</Project>
