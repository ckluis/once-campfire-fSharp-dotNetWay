    <Compile Include="Web/HttpLog.fs" />
    <Compile Include="Web/Acme.fs" />
    <Compile Include="Web/OutputCaching.fs" />
    <Compile Include="Web/Services.fs" />
    <Compile Include="Channels/Auth.fs" />
    <Compile Include="Channels/CableServices.fs" />
    <Compile Include="ActiveStorage.fs" />
    <Compile Include="Presenters/AttachmentWrites.fs" />
    <Compile Include="RichText.fs" />
