    <Compile Include="Controllers/Accounts.fs" />
    <Compile Include="Controllers/Accounts/Bots.fs" />
    <Compile Include="Controllers/Accounts/BotKeys.fs" />
    <Compile Include="Controllers/Accounts/CustomStyles.fs" />
